# Copy to .env and adjust. Never commit .env (ADR 0007).

# --- Django ---------------------------------------------------------------

# Generate with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me

# true only for local development
DEBUG=true

# Comma-separated host names, e.g. www2.vrobot.ch,vrobot.ch,www.vrobot.ch
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins incl. scheme; needed in production behind HTTPS,
# e.g. https://www2.vrobot.ch,https://vrobot.ch
CSRF_TRUSTED_ORIGINS=

# --- Production server (compose.prod.yaml, Caddy) ------------------------

# Domain Caddy serves and gets the TLS certificate for, e.g. www2.vrobot.ch
SITE_ADDRESS=
# X-Robots-Tag header. Default "noindex, nofollow" for the test phase;
# set to "all" when the site goes live.
ROBOTS_TAG=noindex, nofollow
# Image tag to run; default latest. Pin sha-<commit> for a rollback.
IMAGE_TAG=latest

# --- Database (PostgreSQL) ------------------------------------------------

# Used by the db container on first start.
POSTGRES_DB=vrobot
POSTGRES_USER=vrobot
POSTGRES_PASSWORD=change-me

# Used by Django. Host "db" is the Compose service; use localhost when
# running Django outside Docker against a published port.
DATABASE_URL=postgres://vrobot:change-me@db:5432/vrobot

# --- Email (Hostpoint SMTP, ADR 0010) -------------------------------------

# Leave EMAIL_BACKEND unset locally: emails are then printed to the console.
# Production:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=asmtp.mail.hostpoint.ch
#   EMAIL_PORT=465
#   EMAIL_USE_SSL=true
#   EMAIL_HOST_USER=<mailbox address>
#   EMAIL_HOST_PASSWORD=<mailbox password>
#   DEFAULT_FROM_EMAIL=<association address>
DEFAULT_FROM_EMAIL=webmaster@localhost

# --- Site -----------------------------------------------------------------

# Link to the GearsBot emulator in the navigation.
GEARSBOT_URL=https://gears.aposteriori.com.sg/

# --- Contact form ---------------------------------------------------------

# Comma-separated addresses that receive contact form messages.
CONTACT_RECIPIENTS=info@example.org

# Days to keep contact messages in the database (data protection).
CONTACT_MESSAGE_RETENTION_DAYS=365
